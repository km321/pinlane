DATABASE_URL=postgresql://user:password@host:5432/pinlane
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3456
NEXT_PUBLIC_APP_URL=http://localhost:3456

# Optional — Railway Storage Bucket (S3-compatible). Without these,
# screenshots fall back to small data URLs in Postgres (local only).
# STORAGE_ENDPOINT=https://t3.storageapi.dev
# STORAGE_BUCKET=your-bucket-name
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
